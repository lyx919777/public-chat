# 环境变量示例
# 复制此文件为 .env.local 并填入你的配置

# OpenAI API 密钥（必填）
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API 基础 URL（可选，默认 https://api.openai.com/v1）
# 如需使用代理或兼容 API（如 Azure、本地模型等），请设置此项
# 示例：https://api.proxy.com/v1 或 http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型（可选，默认 gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini

# 系统提示词（可选）
OPENAI_SYSTEM_PROMPT=你是一个友好、专业的 AI 助手。请用简洁明了的中文回答用户的问题。

# 应用名称（可选）
NEXT_PUBLIC_APP_NAME=Public Chat
